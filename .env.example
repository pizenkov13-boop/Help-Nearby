# Copy to .env.local and fill in your project values from:
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only (admin panel)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
ADMIN_PASSWORD=your-secure-admin-password

# AI chat (https://console.groq.com)
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1/
AITUNNEL_MODEL=gpt-6-luna 
AITUNNEL_API_KEY=
# ReliefWeb API (https://reliefweb.int/help/api)
RELIEFWEB_APPNAME=help-nearby-sources-a4p8n1QSR

# Optional analytics (https://posthog.com)
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-key
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Set to true in .env.local to send events during npm run dev
NEXT_PUBLIC_POSTHOG_DEBUG=
